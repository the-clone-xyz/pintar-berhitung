{
  "entities": {
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "A record of a player's score in the math game",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the player"
        },
        "score": {
          "type": "number",
          "description": "Final score achieved"
        },
        "difficulty": {
          "type": "string",
          "description": "Game difficulty (Mudah, Sedang, Sulit)"
        },
        "operation": {
          "type": "string",
          "description": "Math operation practiced (Penjumlahan, Pengurangan, Perkalian)"
        },
        "timestamp": {
          "type": "number",
          "description": "Server-side timestamp of the entry"
        }
      },
      "required": ["name", "score", "difficulty", "operation", "timestamp"]
    }
  },
  "firestore": {
    "leaderboard": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public leaderboard scores"
    }
  }
}
